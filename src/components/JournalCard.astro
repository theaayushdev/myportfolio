---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'journal'>;
}

const { post } = Astro.props;
const date = post.data.publishedAt.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<li class="journal-card">
  <time datetime={post.data.publishedAt.toISOString()}>{date}</time>{' · '}<a href={`/journal/${post.id}/`}>{post.data.title}</a>
</li>
