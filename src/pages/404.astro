---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Ayush Dev" description="The page you were looking for could not be found.">
  <section class="not-found section-shell">
    <p class="page-kicker">Error · 404</p>
    <h1>Wrong turn.<br /><em>Good instinct.</em></h1>
    <p>This page doesn’t exist, but there’s plenty worth finding back at the beginning.</p>
    <a class="button button-primary" href="/">Return home <span aria-hidden="true">↗</span></a>
    <span class="not-found-mark" aria-hidden="true">404</span>
  </section>
</BaseLayout>
