---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects } from '@/data/projects';
---

<BaseLayout
  title="Projects | Ayush Dev"
  description="Selected projects and research by Ayush Dev across mobile, web, data, and machine learning."
>
  <article class="projects-page">
    <a class="back-link" href="/">← home</a>
    <h1>projects</h1>
    <p>Things I have explored, built, broken, and learned from.</p>

    <ul class="project-list">
      {projects.map((project) => (
        <li>
          {project.source ? (
            <a href={project.source} target="_blank" rel="noreferrer">{project.name}</a>
          ) : (
            project.name
          )}
          {' '}({project.kind})
          <ul>
            <li>{project.description}</li>
            <li>{project.stack.join(', ')}</li>
            {project.live && (
              <li><a href={project.live} target="_blank" rel="noreferrer">{project.liveLabel ?? 'see live'}</a></li>
            )}
          </ul>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>
